{
  "name": "gocron",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "types": "openapi-ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.3.0",
    "daisyui": "^5.7.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@iconify/json": "^2.2.506",
    "@iconify/tailwind4": "^1.2.3",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  },
  "prettier": {
    "printWidth": 160,
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "es5",
    "endOfLine": "lf",
    "bracketSpacing": true,
    "arrowParens": "always"
  }
