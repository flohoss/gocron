# Docker build context exclusions.
#
# The three node_modules trees (root prettier, web, web/e2e) are ~740 MB and
# are reinstalled inside the builders with `npm ci`, so they must never be
# sent as build context.
node_modules/
web/node_modules/
web/e2e/node_modules/

# VCS metadata is not used by the build (version comes from ldflags) and
# shipping it risks "error obtaining VCS status" on a detached HEAD.
.git

# Build and runtime state. web/dist is the vite output, regenerated in the
# node-builder; web/src/client is regenerated by `npm run types`.
tmp/
web/dist/
web/src/client/
config/config.yaml
config/db.sqlite

# Coverage output; the badge under coverage/ is a repo asset, not a build input.
coverage.out
coverage.out.raw
coverage.txt
coverage.html

# Editor / OS noise.
.vscode
.idea
.history
.DS_Store
*.vsix
__debug*
